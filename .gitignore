# ---- Dependencies ----
node_modules/

# ---- Generated by the runner (rebuilt automatically) ----
# The leading "/" matters: these are folders of the PROJECT (repo root) only.
# Without it, "Reports/" also matched src/reports/ (Git on Windows ignores
# upper/lower case), so the report code was never uploaded to GitHub.
/JsonData/
/Scripts/
/Reports/
/.runs/

# ---- Logs and app files (never commit APKs) ----
/Apps/
*.apk
/logs/
*.part

# ---- Local working data (backups, history, suites) ----
/ExcelBackups/
/FlowBackups/
/History/
/Suites/

# ---- Excel lock files ----
~$*.xlsx
~$*.xls

# ---- OS / editor ----
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.tmp
npm-debug.log*
node_modules

# ---- Phone tools downloaded by Understudy (Setup > Install phone tools) ----
tools/platform-tools/
tools/.staging/
tools/*.part

# ---- Company certificates gathered on this PC (tools/install-deps.ps1) ----
tools/certs/
