# ---- Dependencies ----
node_modules/

# ---- Generated by the runner (rebuilt automatically) ----
JsonData/
Scripts/
Reports/
.runs/

# ---- Logs and app files (never commit APKs) ----
Apps/
*.apk
logs/
*.part

# ---- Local working data (backups, history, suites) ----
ExcelBackups/
FlowBackups/
History/
Suites/

# ---- Excel lock files ----
~$*.xlsx
~$*.xls

# ---- OS / editor ----
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.tmp
npm-debug.log*
node_modules

# ---- Phone tools downloaded by Understudy (Setup > Install phone tools) ----
tools/platform-tools/
tools/.staging/
tools/*.part

# ---- Company certificates gathered on this PC (tools/install-deps.ps1) ----
tools/certs/
